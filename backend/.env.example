PORT=3000

# How long each role holds the task, in milliseconds.
# SIM_DELAY_MS=1400

# State file. Defaults to backend/data/state.json when the backend
# is started from the backend package.
# DATA_PATH=data/state.json

# Leave MODEL_API_KEY unset to simulate every role.
# AGENT_MODE=simulated forces the simulator even if a key is set.
# AGENT_MODE=model requires MODEL_API_KEY.
# MODEL_API_KEY=
# MODEL_BASE_URL=https://api.openai.com/v1
# MODEL_NAME=gpt-4o-mini
# AGENT_MODE=simulated
