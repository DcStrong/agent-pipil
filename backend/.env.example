PORT=3000

# Пауза имитации одного шага, в миллисекундах. По умолчанию 1100.
# SIM_DELAY_MS=1100

# Файл состояния. Если backend запущен из каталога backend, путь по умолчанию data/state.json.
# DATA_PATH=data/state.json

# Токен Cursor хранится на сервере. В браузер уходит только признак подключения.
# Для токена, сохранённого через настройки, видна маска из последних 4 символов.
# Пока токена нет, агенты со средой Cursor показаны как «Не подключён», а приложение открывается.
# CURSOR_API_TOKEN=

# CURSOR_LIVE=0 отключает вызов Cloud Agents API даже при сохранённом токене.
# CURSOR_POLL_MS — максимальное ожидание ответа Cursor, мс (по умолчанию 120000).
# CURSOR_LIVE=
# CURSOR_POLL_MS=
